# Copy to .env.local and replace the placeholder values.
# Never commit real credentials.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Docker PostgreSQL
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DATABASE_URL=postgresql://mock_test:REPLACE_WITH_DATABASE_PASSWORD@localhost:5432/mock_test_app

# Authentication
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AUTH_SECRET